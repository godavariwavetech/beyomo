<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      android:enableOnBackInvokedCallback="false">

      <!-- Empty key so react-native-maps initialises without crashing; OSM tiles used via UrlTile -->
      <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value=""/>

      <!-- Firebase fallback channel — used when a background/killed-app FCM message
           doesn't carry android.notification.channel_id. Without this, Firebase
           creates its own "Miscellaneous" channel.

           This MUST stay the plain default channel. Pointing it at the new-booking
           channel made every background notification — cancellations, reschedules,
           account messages, broadcasts — play the new-order alert sound, because the
           channel decides the sound on Android 8+ and this is the channel they all
           landed on. New-order pushes ask for the custom channel explicitly by
           sending android.notification.channel_id, so they are unaffected. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="beyomo_partner_default"
        tools:replace="android:value"/>

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
