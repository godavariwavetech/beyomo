require "base64"
require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "com.beyomopartner".freeze
TEAM_ID        = "3387GM7U6B".freeze
SCHEME         = "beyomopartner".freeze
XCODEPROJ      = "ios/beyomopartner.xcodeproj".freeze
WORKSPACE      = "ios/beyomopartner.xcworkspace".freeze

platform :ios do
  desc "Build a signed Release IPA and upload it to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    key_id    = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_b64   = ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_b64,
      is_key_content_base64: true
    )

    # Build numbers must be unique per version, so continue from TestFlight.
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER
      ) + 1
    )

    xcargs = nil
    if ENV["MATCH_GIT_URL"].to_s.empty?
      # No match repo configured: let Xcode create/download the distribution
      # certificate and profile itself through the App Store Connect API key
      # (project already uses automatic signing). Key needs Admin access.
      UI.important("MATCH_GIT_URL not set - using Xcode automatic signing via API key")
      key_file = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
      File.write(key_file, Base64.decode64(key_b64))
      xcargs = "-allowProvisioningUpdates "                "-authenticationKeyPath #{key_file} "                "-authenticationKeyID #{key_id} "                "-authenticationKeyIssuerID #{issuer_id}"
    else
      # Fetches (or, on the first run, creates) the App Store distribution
      # certificate + profile. Set the MATCH_READONLY repo variable to true once they exist.
      match(
        type: "appstore",
        app_identifier: APP_IDENTIFIER,
        api_key: api_key,
        readonly: ENV["IOS_MATCH_READONLY"] == "true"
      )

      # Switch the app target to the match profile for the CI build only.
      update_code_signing_settings(
        use_automatic_signing: false,
        path: XCODEPROJ,
        team_id: TEAM_ID,
        targets: [SCHEME],
        code_sign_identity: "Apple Distribution",
        profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]
      )
    end

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "#{SCHEME}.ipa",
      clean: true,
      xcargs: xcargs,
      export_xcargs: xcargs
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
