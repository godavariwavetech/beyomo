# SPA fallback — without this, reloading any non-root route (e.g. /about, /contact,
# /become-a-partner) hits Apache directly and 404s, since there's no real file at that
# path. This rewrites any request that isn't an existing file/directory to index.html,
# so React Router can handle the route client-side.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (JS/CSS/images/etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to index.html
  RewriteRule ^ index.html [L]
</IfModule>
