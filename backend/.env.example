NODE_ENV=development
PORT=3000

# SSL Certificates (leave blank to run HTTP, fill to enable HTTPS)
SSL_KEY_PATH=/path/to/private.key
SSL_CERT_PATH=/path/to/certificate.crt
SSL_CA_PATH=/path/to/ca_bundle.crt
HTTP_PORT=80

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=beyomo
DB_USER=root
DB_PASS=your_mysql_password

# JWT
TOKEN_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=1d

# SunsTechIT SMS
SUNSTECH_SMS_KEY=your_sunstechit_api_key
SUNSTECH_SMS_ROUTE_ID=13
SUNSTECH_SMS_SENDER_ID=GDWOTP
SUNSTECH_SMS_TEMPLATE_ID=your_dlt_template_id
MOCK_SMS=true

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Logs
LOGS_PATH=./logs/

# App
APP_NAME=Beyomo
