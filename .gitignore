# Dependency directories
**/node_modules/
jspm_packages/

# Build outputs
**/dist/
**/build/
**/out/
.next/
.serverless/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE files
.vscode/
.idea/
.claude/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Optional: React Native / Mobile specific (since there are mobile projects)
ios/build/
android/build/
android/.gradle/
local.properties
*.keystore
!debug.keystore

# Zip archives / build packages -- never commit these
*.zip

# Separate repo nested in this working tree, has its own git history
/beyomo_website/

# Database dumps -- these carry real customer and partner PII (phone numbers,
# emails, bank account numbers, Aadhaar document URLs). Share them out of band,
# never through the repo. backend/db_export/ is the historical exception that is
# already tracked; do not add more.
/backend/*.sql

# Firebase service-account key - secret, never commit
firebase-service-account.json
**/firebase-service-account.json
